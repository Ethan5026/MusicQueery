{
  "name": "@mq/listen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "eval": "esbuild scripts/eval.ts --bundle --platform=node --format=esm --outfile=dist/eval.mjs --log-level=warning && node dist/eval.mjs",
    "sweep": "esbuild scripts/sweep.ts --bundle --platform=node --format=esm --outfile=dist/sweep.mjs --log-level=warning && node dist/sweep.mjs"
  },
  "dependencies": {
    "@mq/model": "workspace:*",
    "@mq/theory": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.1"
  }
}
