{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "mq.timeline/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "spotify:track:<id> or chart:<id>"
    },
    "source": {
      "type": "string",
      "enum": [
        "analysed",
        "live",
        "predicted",
        "exact"
      ]
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "generator": {
      "type": "string",
      "maxLength": 80
    },
    "chartId": {
      "type": "string",
      "maxLength": 120
    },
    "meter": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "den": {
          "type": "number",
          "enum": [
            1,
            2,
            4,
            8,
            16
          ]
        }
      },
      "required": [
        "num",
        "den"
      ]
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "description": "Beat onsets in ms, ascending"
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Bar number within the form (1-based)"
          },
          "section": {
            "type": "string",
            "maxLength": 40
          },
          "pass": {
            "description": "Chorus / repeat pass, 1-based",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "chartBar": {
            "description": "Index into Chart.bars when derived from a chart",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "startMs",
          "number"
        ]
      }
    },
    "chords": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "minimum": 0
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "startMs",
          "endMs",
          "symbol"
        ]
      }
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "minimum": 0
          },
          "tonic": {
            "type": "string",
            "pattern": "^[A-G](?:♭{1,2}|♯{1,2})?$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "major",
              "minor"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "startMs",
          "endMs",
          "tonic",
          "mode"
        ]
      }
    },
    "tempo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "bpm": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "startMs",
          "bpm"
        ]
      }
    },
    "edits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "minimum": 0
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "prev": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "at",
          "startMs",
          "endMs",
          "symbol"
        ]
      }
    },
    "melody": {
      "description": "Lead melody (M9), ascending by startMs",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "minimum": 0
          },
          "midi": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "stem": {
            "description": "Separated stem the note was heard in",
            "type": "string",
            "enum": [
              "vocals",
              "other"
            ]
          }
        },
        "required": [
          "startMs",
          "endMs",
          "midi"
        ]
      }
    },
    "charts": {
      "description": "iReal charts whose title matches the track (M12); the phone lines them up and links the one that fits",
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "mq.chart/1"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "composer": {
            "type": "string",
            "maxLength": 200
          },
          "style": {
            "type": "string",
            "maxLength": 80
          },
          "key": {
            "type": "object",
            "properties": {
              "tonic": {
                "type": "string",
                "pattern": "^[A-G](?:♭{1,2}|♯{1,2})?$"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "major",
                  "minor"
                ]
              }
            },
            "required": [
              "tonic",
              "mode"
            ]
          },
          "meter": {
            "type": "object",
            "properties": {
              "num": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "den": {
                "type": "number",
                "enum": [
                  1,
                  2,
                  4,
                  8,
                  16
                ]
              }
            },
            "required": [
              "num",
              "den"
            ]
          },
          "tempo": {
            "description": "BPM",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 400
          },
          "choruses": {
            "description": "Default number of times the form is played",
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "bars": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "chords": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "symbol": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "beats": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Duration in beats of the bar meter"
                      },
                      "alt": {
                        "description": "Alternate chord printed above (iReal parentheses)",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "symbol",
                      "beats"
                    ]
                  }
                },
                "meter": {
                  "description": "Time signature change starting at this bar",
                  "type": "object",
                  "properties": {
                    "num": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "den": {
                      "type": "number",
                      "enum": [
                        1,
                        2,
                        4,
                        8,
                        16
                      ]
                    }
                  },
                  "required": [
                    "num",
                    "den"
                  ]
                },
                "section": {
                  "description": "Rehearsal mark starting here: A, B, Intro, Verse…",
                  "type": "string",
                  "maxLength": 20
                },
                "repeatStart": {
                  "type": "boolean",
                  "const": true
                },
                "repeatEnd": {
                  "description": "Repeat sign at the end of this bar; total passes",
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 16
                },
                "ending": {
                  "description": "Volta (1st/2nd ending) starting at this bar",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9
                },
                "segno": {
                  "type": "boolean",
                  "const": true
                },
                "toCoda": {
                  "description": "Jump to the coda after this bar once a D.C./D.S. al Coda was taken",
                  "type": "boolean",
                  "const": true
                },
                "coda": {
                  "description": "Coda starts at this bar",
                  "type": "boolean",
                  "const": true
                },
                "jump": {
                  "description": "Taken at the end of this bar",
                  "type": "string",
                  "enum": [
                    "D.C.",
                    "D.C. al Fine",
                    "D.C. al Coda",
                    "D.S.",
                    "D.S. al Fine",
                    "D.S. al Coda"
                  ]
                },
                "fine": {
                  "type": "boolean",
                  "const": true
                },
                "end": {
                  "description": "iReal \"END\": where the final chorus stops",
                  "type": "boolean",
                  "const": true
                },
                "fermata": {
                  "type": "boolean",
                  "const": true
                },
                "simile": {
                  "description": "Written as a bar repeat (%)",
                  "type": "boolean",
                  "const": true
                },
                "comment": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "chords"
              ]
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "ireal",
                  "manual",
                  "demo"
                ]
              },
              "playlist": {
                "type": "string"
              },
              "raw": {
                "description": "Original encoded music string",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "schema",
          "id",
          "title",
          "key",
          "meter",
          "bars"
        ]
      }
    }
  },
  "required": [
    "schema",
    "id",
    "source",
    "durationMs",
    "createdAt",
    "meter",
    "beats",
    "bars",
    "chords",
    "keys",
    "tempo"
  ]
}
